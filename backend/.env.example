# Generate a Fernet key (32 urlsafe-base64 bytes)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# Any random string (>= 32 chars recommended)
JWT_SECRET=

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# dev|prod (dev uses mock market data)
APP_MODE=dev

# Optional: override full DB URL (otherwise SQLITE_PATH is used)
# DATABASE_URL=sqlite:////absolute/path/to/app.db
DATABASE_URL=

# SQLite file path (relative to backend/)
SQLITE_PATH=./data/crazynet_backups.db

# Backup output folder (relative to backend/)
BACKUP_ROOT=./backups

# Max parallel SSH backups
MAX_PARALLEL_BACKUPS=3

# Market monitor refresh cadence (seconds)
MARKET_PRICE_REFRESH_SECONDS=300
MARKET_MACRO_REFRESH_SECONDS=3600
MARKET_PREDICTION_REFRESH_SECONDS=900

# Future real provider API keys (unused in dev mock mode)
API_KEY_ALPHA_VANTAGE=
API_KEY_YAHOO_FINANCE=
